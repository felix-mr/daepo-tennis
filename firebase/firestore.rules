rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validScore() {
      let data = request.resource.data;
      let fields = ['date', 'round', 'floor', 'teamA', 'teamB', 'teamANames', 'teamBNames', 'fixedPlayerIds', 'scoreA', 'scoreB', 'outcome', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.scoreA is int && data.scoreA >= 0 && data.scoreA <= 99
        && data.scoreB is int && data.scoreB >= 0 && data.scoreB <= 99
        && data.outcome == (data.scoreA > data.scoreB ? 'teamA' : (data.scoreA < data.scoreB ? 'teamB' : 'draw'))
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{userId} {
      function validUser() {
        let users = {"p001": {"name": "서명렬", "gender": "male", "memberType": "fixed"}, "p002": {"name": "김영진", "gender": "male", "memberType": "fixed"}, "p003": {"name": "나창은", "gender": "male", "memberType": "fixed"}, "p004": {"name": "박세준", "gender": "male", "memberType": "fixed"}, "p005": {"name": "이재원", "gender": "male", "memberType": "fixed"}, "p006": {"name": "조아라", "gender": "female", "memberType": "fixed"}, "p007": {"name": "성주은", "gender": "female", "memberType": "fixed"}, "p008": {"name": "박정민", "gender": "female", "memberType": "fixed"}, "p009": {"name": "정가영", "gender": "female", "memberType": "fixed"}, "p010": {"name": "김규석", "gender": "male", "memberType": "fixed"}, "p011": {"name": "위형종", "gender": "male", "memberType": "fixed"}};
        let data = request.resource.data;
        return userId in users && data.keys().hasAll(['name', 'gender', 'memberType', 'createdAt'])
          && data.keys().hasOnly(['name', 'gender', 'memberType', 'createdAt'])
          && data.name == users[userId].name && data.gender == users[userId].gender
          && data.memberType == 'fixed' && data.createdAt == request.time;
      }
      allow read: if true;
      allow create: if validUser();
      allow update, delete: if false;
    }
    match /membershipPeriods/{period} {
      function validPeriod() {
        let periods = {"current-members": {"memberIds": ["p001", "p002", "p003", "p004", "p005", "p006", "p007", "p008", "p009", "p010", "p011"], "label": "8~10월(임시)", "startsOn": "2026-08-01", "endsBefore": "2026-11-01"}};
        let data = request.resource.data;
        return period in periods && data.keys().hasAll(['period', 'label', 'memberIds', 'startsOn', 'endsBefore', 'updatedAt'])
          && data.keys().hasOnly(['period', 'label', 'memberIds', 'startsOn', 'endsBefore', 'updatedAt'])
          && data.period == period && data.memberIds == periods[period].memberIds
          && data.label == periods[period].label
          && data.startsOn == periods[period].startsOn && data.endsBefore == periods[period].endsBefore
          && data.updatedAt == request.time;
      }
      allow read: if true;
      allow create: if validPeriod();
      allow update: if validPeriod()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'startsOn', 'endsBefore', 'memberIds', 'updatedAt']);
      allow delete: if false;
    }
    // Collection-group reads power cumulative records; writes are limited below.
    match /{path=**}/matchResults/{matchId} {
      allow read: if true;
    }
    match /schedules/2026-10-03/matchResults/{matchId} {
      function validMatch() {
        let matches = {"r1-f1": {"round": 1, "floor": 1, "date": "2026-10-03", "fixedPlayerIds": ["p001", "p004"], "teamA": ["p001", "guest-2026-10-03-03"], "teamB": ["p004", "guest-2026-10-03-02"], "teamANames": ["서명렬", "송효종"], "teamBNames": ["박세준", "안홍익"]}, "r1-f2": {"round": 1, "floor": 2, "date": "2026-10-03", "fixedPlayerIds": ["p005", "p006", "p008"], "teamA": ["p005", "p006"], "teamB": ["guest-2026-10-03-01", "p008"], "teamANames": ["이재원", "조아라"], "teamBNames": ["정상현", "박정민"]}, "r2-f1": {"round": 2, "floor": 1, "date": "2026-10-03", "fixedPlayerIds": ["p002", "p006", "p004", "p008"], "teamA": ["p002", "p006"], "teamB": ["p004", "p008"], "teamANames": ["김영진", "조아라"], "teamBNames": ["박세준", "박정민"]}, "r2-f2": {"round": 2, "floor": 2, "date": "2026-10-03", "fixedPlayerIds": ["p003", "p005", "p007"], "teamA": ["p003", "guest-2026-10-03-04"], "teamB": ["p005", "p007"], "teamANames": ["나창은", "권태경"], "teamBNames": ["이재원", "성주은"]}, "r3-f1": {"round": 3, "floor": 1, "date": "2026-10-03", "fixedPlayerIds": ["p005"], "teamA": ["p005", "guest-2026-10-03-03"], "teamB": ["guest-2026-10-03-01", "guest-2026-10-03-02"], "teamANames": ["이재원", "송효종"], "teamBNames": ["정상현", "안홍익"]}, "r3-f2": {"round": 3, "floor": 2, "date": "2026-10-03", "fixedPlayerIds": ["p001", "p003", "p007"], "teamA": ["p001", "guest-2026-10-03-04"], "teamB": ["p003", "p007"], "teamANames": ["서명렬", "권태경"], "teamBNames": ["나창은", "성주은"]}, "r4-f1": {"round": 4, "floor": 1, "date": "2026-10-03", "fixedPlayerIds": ["p001", "p004", "p002", "p005"], "teamA": ["p001", "p004"], "teamB": ["p002", "p005"], "teamANames": ["서명렬", "박세준"], "teamBNames": ["김영진", "이재원"]}, "r4-f2": {"round": 4, "floor": 2, "date": "2026-10-03", "fixedPlayerIds": ["p006", "p008", "p007"], "teamA": ["p006", "p008"], "teamB": ["p007", "guest-2026-10-03-04"], "teamANames": ["조아라", "박정민"], "teamBNames": ["성주은", "권태경"]}, "r5-f1": {"round": 5, "floor": 1, "date": "2026-10-03", "fixedPlayerIds": ["p002"], "teamA": ["p002", "guest-2026-10-03-01"], "teamB": ["guest-2026-10-03-02", "guest-2026-10-03-03"], "teamANames": ["김영진", "정상현"], "teamBNames": ["안홍익", "송효종"]}, "r5-f2": {"round": 5, "floor": 2, "date": "2026-10-03", "fixedPlayerIds": ["p003", "p008", "p004", "p006"], "teamA": ["p003", "p008"], "teamB": ["p004", "p006"], "teamANames": ["나창은", "박정민"], "teamBNames": ["박세준", "조아라"]}, "r6-f1": {"round": 6, "floor": 1, "date": "2026-10-03", "fixedPlayerIds": ["p001", "p003", "p002"], "teamA": ["p001", "p003"], "teamB": ["p002", "guest-2026-10-03-03"], "teamANames": ["서명렬", "나창은"], "teamBNames": ["김영진", "송효종"]}, "r6-f2": {"round": 6, "floor": 2, "date": "2026-10-03", "fixedPlayerIds": ["p007"], "teamA": ["guest-2026-10-03-01", "guest-2026-10-03-04"], "teamB": ["guest-2026-10-03-02", "p007"], "teamANames": ["정상현", "권태경"], "teamBNames": ["안홍익", "성주은"]}};
        let data = request.resource.data;
        return matchId in matches && data.date == '2026-10-03'
          && data.round == matches[matchId].round && data.floor == matches[matchId].floor
          && data.teamA == matches[matchId].teamA && data.teamB == matches[matchId].teamB
          && data.teamANames == matches[matchId].teamANames
          && data.teamBNames == matches[matchId].teamBNames
          && data.fixedPlayerIds == matches[matchId].fixedPlayerIds;
      }
      allow create: if validScore() && validMatch();
      allow update: if validScore() && validMatch()
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoreA', 'scoreB', 'outcome', 'updatedAt'])
          || (!resource.data.keys().hasAny(['fixedPlayerIds'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoreA', 'scoreB', 'outcome', 'updatedAt', 'fixedPlayerIds'])));
      allow delete: if false;
    }
    match /schedules/2026-10-10/matchResults/{matchId} {
      function validMatch() {
        let matches = {"r1-f1": {"round": 1, "floor": 1, "date": "2026-10-10", "fixedPlayerIds": ["p005", "p011", "p009"], "teamA": ["p005", "guest-2026-10-10-04"], "teamB": ["p011", "p009"], "teamANames": ["이재원", "추진영"], "teamBNames": ["위형종", "정가영"]}, "r1-f2": {"round": 1, "floor": 2, "date": "2026-10-10", "fixedPlayerIds": ["p001", "p003", "p004"], "teamA": ["p001", "p003"], "teamB": ["p004", "guest-2026-10-10-01"], "teamANames": ["서명렬", "나창은"], "teamBNames": ["박세준", "김규현"]}, "r2-f1": {"round": 2, "floor": 1, "date": "2026-10-10", "fixedPlayerIds": ["p007", "p008", "p009"], "teamA": ["p007", "guest-2026-10-10-04"], "teamB": ["p008", "p009"], "teamANames": ["성주은", "추진영"], "teamBNames": ["박정민", "정가영"]}, "r2-f2": {"round": 2, "floor": 2, "date": "2026-10-10", "fixedPlayerIds": ["p001"], "teamA": ["p001", "guest-2026-10-10-03"], "teamB": ["guest-2026-10-10-01", "guest-2026-10-10-02"], "teamANames": ["서명렬", "김진수"], "teamBNames": ["김규현", "정상현"]}, "r3-f1": {"round": 3, "floor": 1, "date": "2026-10-10", "fixedPlayerIds": ["p003", "p005", "p011"], "teamA": ["p003", "guest-2026-10-10-03"], "teamB": ["p005", "p011"], "teamANames": ["나창은", "김진수"], "teamBNames": ["이재원", "위형종"]}, "r3-f2": {"round": 3, "floor": 2, "date": "2026-10-10", "fixedPlayerIds": ["p001", "p004", "p008"], "teamA": ["p001", "guest-2026-10-10-04"], "teamB": ["p004", "p008"], "teamANames": ["서명렬", "추진영"], "teamBNames": ["박세준", "박정민"]}, "r4-f1": {"round": 4, "floor": 1, "date": "2026-10-10", "fixedPlayerIds": ["p009", "p007"], "teamA": ["guest-2026-10-10-02", "p009"], "teamB": ["guest-2026-10-10-03", "p007"], "teamANames": ["정상현", "정가영"], "teamBNames": ["김진수", "성주은"]}, "r4-f2": {"round": 4, "floor": 2, "date": "2026-10-10", "fixedPlayerIds": ["p001", "p004", "p003"], "teamA": ["p001", "p004"], "teamB": ["p003", "guest-2026-10-10-01"], "teamANames": ["서명렬", "박세준"], "teamBNames": ["나창은", "김규현"]}, "r5-f1": {"round": 5, "floor": 1, "date": "2026-10-10", "fixedPlayerIds": ["p004", "p005", "p011"], "teamA": ["p004", "p005"], "teamB": ["p011", "guest-2026-10-10-02"], "teamANames": ["박세준", "이재원"], "teamBNames": ["위형종", "정상현"]}, "r5-f2": {"round": 5, "floor": 2, "date": "2026-10-10", "fixedPlayerIds": ["p007", "p008", "p009"], "teamA": ["p007", "guest-2026-10-10-04"], "teamB": ["p008", "p009"], "teamANames": ["성주은", "추진영"], "teamBNames": ["박정민", "정가영"]}, "r6-f1": {"round": 6, "floor": 1, "date": "2026-10-10", "fixedPlayerIds": ["p005", "p011"], "teamA": ["p005", "guest-2026-10-10-02"], "teamB": ["p011", "guest-2026-10-10-03"], "teamANames": ["이재원", "정상현"], "teamBNames": ["위형종", "김진수"]}, "r6-f2": {"round": 6, "floor": 2, "date": "2026-10-10", "fixedPlayerIds": ["p003", "p007", "p008"], "teamA": ["p003", "p007"], "teamB": ["guest-2026-10-10-01", "p008"], "teamANames": ["나창은", "성주은"], "teamBNames": ["김규현", "박정민"]}};
        let data = request.resource.data;
        return matchId in matches && data.date == '2026-10-10'
          && data.round == matches[matchId].round && data.floor == matches[matchId].floor
          && data.teamA == matches[matchId].teamA && data.teamB == matches[matchId].teamB
          && data.teamANames == matches[matchId].teamANames
          && data.teamBNames == matches[matchId].teamBNames
          && data.fixedPlayerIds == matches[matchId].fixedPlayerIds;
      }
      allow create: if validScore() && validMatch();
      allow update: if validScore() && validMatch()
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoreA', 'scoreB', 'outcome', 'updatedAt'])
          || (!resource.data.keys().hasAny(['fixedPlayerIds'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoreA', 'scoreB', 'outcome', 'updatedAt', 'fixedPlayerIds'])));
      allow delete: if false;
    }
  }
}
